{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:watch": "vitest",
    "cap:sync": "npm run build && cap sync",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run build && npx cap sync android",
    "android:ota:bundle": "npm run build && npx @capgo/cli bundle zip kz.educorex.app --path dist",
    "android:ota:publish": "npm run build && npx @capgo/cli bundle upload kz.educorex.app --path dist --channel production --apikey %CAPGO_TOKEN%",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "electron:prepare": "node node_modules/electron/install.js",
    "electron:dev": "npm run build && npm run electron:prepare && electron .",
    "electron:build": "npm run build && npm run electron:prepare && electron-builder --publish never",
    "dist:win": "npm run build && npm run electron:prepare && electron-builder --win --publish never",
    "publish:win": "npm run build && npm run electron:prepare && electron-builder --win --publish always",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.4",
    "@capgo/capacitor-updater": "^8.46.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-query": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@capgo/cli": "^7.103.0",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.4.21",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "kz.educorex.desktop",
    "productName": "Edu CoreX",
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build-resources/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Edu CoreX"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Ibrahim200546",
        "repo": "inclusiveapp"
      }
    ]
  },
  "overrides": {
    "@swc/core": "1.15.46"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
