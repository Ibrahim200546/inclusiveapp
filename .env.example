# Public frontend configuration.
# Safe to expose in the browser: Supabase URL and anon public key only.
VITE_SUPABASE_URL=https://mmugalgqdapidqqxekqt.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-supabase-anon-public-key
VITE_SUPABASE_AUTH_STORAGE_KEY=sb-mmugalgqdapidqqxekqt-auth-token

# Server-only secrets. Set these in Vercel, your Node server, or local .env.
# Do not prefix secrets with VITE_ and do not ship them in React frontend code.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
YANDEX_API_KEY=
YANDEX_IAM_TOKEN=
YANDEX_FOLDER_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TTS_UPSTREAM_URL=

# Server-only AI authentication/quota settings (never prefix private keys with VITE_)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Edge Function secrets; configure through Supabase secret storage, not the client
# Use independent random values, at least 32 characters each.
CONTACT_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET=
